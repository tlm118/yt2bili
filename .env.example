# 复制本文件为 .env 后填入真实值；切勿将 .env 提交到任何仓库！
# 正式部署时，这些值应放在 GitHub Secrets（B 站相关）与 Cloudflare Pages 环境变量（GitHub 相关）。

# —— B 站登录态（从浏览器 Cookie 提取，SESSDATA 保持 URL 编码原样）——
BILI_SESSDATA=你的SESSDATA值
BILI_BILI_JCT=你的bili_jct值
BILI_BUVID3=你的buvid3值

# 多账号（可选，二选一，优先级高于上面三个单变量）
# BILI_ACCOUNTS=[{"name":"acc1","sessdata":"...","bili_jct":"...","buvid3":"..."},{"name":"acc2","sessdata":"...","bili_jct":"...","buvid3":"..."}]

# —— 翻译（可选）——
TRANSLATE_PROVIDER=mymemory   # mymemory | google

# —— GitHub（仅 Cloudflare Pages 看板需要，用于读取/写回仓库文件）——
GH_REPO=你的用户名/仓库名
GH_BRANCH=main
GH_TOKEN=你的GitHub_PAT
